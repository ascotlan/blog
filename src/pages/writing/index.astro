---
import Base from '../../layouts/Base.astro';
import PostItem from '../../components/PostItem.astro';
import { getPublishedPosts, tagSlug } from '../../lib';

const posts = await getPublishedPosts();
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getUTCFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
const tagCounts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Writing" description="Engineering notes on agentic AI at work, evaluating AI systems, and systems analysis.">
  <section class="intro band">
    <div class="container container--writing intro-content">
      <div class="section-heading">
        <p class="eyebrow">Writing</p>
        <h1 class="h-section">Engineering notes, with the evidence left in</h1>
        <p class="desc">Practical writing about agentic AI at work, evaluating AI systems, and systems analysis.</p>
      </div>
      <p class="count">{pad(posts.length)} FIELD {posts.length === 1 ? 'NOTE' : 'NOTES'}</p>
    </div>
  </section>

  {tags.length > 0 && (
    <section class="filters band--alt band--rule" aria-label="Filter by topic">
      <div class="container container--writing filter-bar">
        <p class="filter-label">FILTER BY TOPIC</p>
        <div class="filter-buttons" role="group" aria-label="Topics">
          <button type="button" data-filter="all" aria-pressed="true">ALL {pad(posts.length)}</button>
          {tags.map(([t, n]) => <button type="button" data-filter={tagSlug(t)} aria-pressed="false">{t.toUpperCase()} {pad(n)}</button>)}
        </div>
      </div>
    </section>
  )}

  <section class="band archive">
    <div class="container container--writing">
      {posts.length === 0 && (
        <p class="empty">The first field notes are being written. Check back soon, or subscribe by <a href="/rss.xml">RSS</a>.</p>
      )}
      {[...byYear.entries()].map(([year, list]) => (
        <div class="year-group" data-year-group>
          <div class="year-marker">
            <p class="year">{year}</p>
            <p class="year-sub">ARCHIVE</p>
          </div>
          <ul class="post-list inventory">{list.map((post) => <PostItem post={post} />)}</ul>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .intro { padding-top: 88px; padding-bottom: 44px; }
  .intro-content { display: flex; flex-direction: column; gap: 18px; }
  .count { font: 400 12px/1.4 var(--font-mono); color: var(--muted); }
  .filters { padding: 22px var(--gutter); }
  .filter-bar { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
  .filter-label { font: 700 11px/1.8 var(--font-mono); color: var(--muted); white-space: nowrap; }
  .filter-buttons { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px 14px; }
  .filter-buttons button {
    border: 0; background: none; padding: 2px 4px; cursor: pointer;
    font: 400 11px/1.8 var(--font-mono); color: var(--accent-text);
  }
  .filter-buttons button:hover { text-decoration: underline; }
  .filter-buttons button[aria-pressed='true']::before { content: '[ '; }
  .filter-buttons button[aria-pressed='true']::after { content: ' ]'; }
  .archive { padding-top: 72px; }
  .archive .container { display: flex; flex-direction: column; gap: 48px; }
  .year-group { display: flex; gap: 44px; align-items: flex-start; }
  .year-group[hidden] { display: none; }
  .year-marker { width: 120px; flex: none; display: flex; flex-direction: column; gap: 5px; }
  .year { font: 700 32px/1.1 var(--font-mono); }
  .year-sub { font: 400 10px/1.3 var(--font-mono); color: var(--muted); }
  .inventory { flex: 1; min-width: 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 12px 0 24px; }
  .inventory :global(.title) { font-size: 18px; }
  .inventory :global(li[hidden]) { display: none; }
  .empty { color: var(--muted); }
  @media (max-width: 760px) {
    .intro { padding-top: 56px; }
    .filter-bar { flex-direction: column; gap: 8px; }
    .filter-buttons { justify-content: flex-start; }
    .year-group { flex-direction: column; gap: 16px; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      document.querySelectorAll<HTMLElement>('.inventory li').forEach((li) => {
        li.hidden = f !== 'all' && !(li.dataset.tags ?? '').split(' ').includes(f);
      });
      document.querySelectorAll<HTMLElement>('[data-year-group]').forEach((g) => {
        g.hidden = !g.querySelector('li:not([hidden])');
      });
    })
  );
</script>
