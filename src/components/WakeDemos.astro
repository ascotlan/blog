---
// Starts waking sleeping demo backends (Render free tier) as soon as a page with project demos loads,
// so the demo is ready, or close to it, by the time a visitor clicks. Fire-and-forget; errors are ignored.
---
<script>
  const wake = () => {
    const urls = [...new Set([...document.querySelectorAll<HTMLElement>('[data-wake]')].map((el) => el.dataset.wake!))];
    for (const url of urls) {
      const key = `wake:${url}`;
      try {
        const last = Number(sessionStorage.getItem(key));
        if (last && Date.now() - last < 10 * 60 * 1000) continue; // already pinged in the last 10 minutes
        sessionStorage.setItem(key, String(Date.now()));
      } catch {}
      fetch(url, { mode: 'no-cors', cache: 'no-store', keepalive: true }).catch(() => {});
    }
  };
  if ('requestIdleCallback' in window) requestIdleCallback(wake, { timeout: 2000 });
  else setTimeout(wake, 800);
</script>
