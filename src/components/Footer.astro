---
import { SITE } from '../site.config.mjs';
const links = [
  SITE.github && { href: SITE.github, label: 'GitHub ↗' },
  SITE.linkedin && { href: SITE.linkedin, label: 'LinkedIn ↗' },
  SITE.email && { href: `mailto:${SITE.email}`, label: 'Email ↗' },
  { href: '/rss.xml', label: 'RSS' },
].filter(Boolean) as { href: string; label: string }[];
---
<footer class="site-footer">
  <div class="footer-top">
    <p class="statement">{SITE.footerStatement}</p>
    <nav class="footer-links" aria-label="Elsewhere">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
  <p class="footer-meta">
    © {new Date().getFullYear()} {SITE.author}<span aria-hidden="true">　·　</span>blog.scenehere.ca<span aria-hidden="true">　·　</span>Built with Astro
  </p>
</footer>

<style>
  .site-footer {
    display: flex; flex-direction: column; gap: 28px; padding: 48px var(--gutter);
    background: var(--surface-alt); border-top: 1px solid var(--border);
  }
  .footer-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
  .statement { max-width: 520px; font-size: 16px; line-height: 1.5; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 8px 22px; justify-content: flex-end; }
  .footer-links a { font: 600 12px/1.5 var(--font-mono); color: var(--accent-text); text-decoration: none; }
  .footer-links a:hover { text-decoration: underline; }
  .footer-meta { font: 400 11px/1.6 var(--font-mono); color: var(--muted); text-align: right; }
  @media (max-width: 760px) {
    .site-footer { padding: 36px var(--gutter); gap: 20px; }
    .footer-top { flex-direction: column; }
    .footer-links { justify-content: flex-start; }
    .footer-meta { text-align: left; }
  }
</style>
