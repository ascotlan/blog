---
// Headshot when SITE.photo is set, otherwise the monogram.
import { SITE } from '../site.config.mjs';
interface Props { size?: number; class?: string }
const { size = 64, class: className } = Astro.props;
---
{SITE.photo ? (
  <img class:list={['avatar', className]} src={SITE.photo} alt={SITE.author} width={size} height={size} loading="lazy" decoding="async" style={`width:${size}px;height:${size}px`} />
) : (
  <span class:list={['avatar', 'avatar--mono', className]} aria-hidden="true" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.31)}px`}>{SITE.initials}</span>
)}

<style>
  .avatar { display: block; flex: none; border-radius: 50%; object-fit: cover; }
  img.avatar { border: 1px solid var(--border); background: var(--surface-alt); }
  .avatar--mono { display: grid; place-items: center; background: var(--accent); color: var(--on-accent); font-family: var(--font-mono); font-weight: 700; line-height: 1; }
</style>
